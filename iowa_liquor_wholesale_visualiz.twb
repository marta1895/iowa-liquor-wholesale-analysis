    <worksheet name='MoM Sales'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium'>Monthly Sales Heatmap </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>October</run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'> and </run>
            <run bold='true' fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>December</run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'> are the</run>
            <run fontcolor='#898989' fontname='Tableau Regular' fontsize='8'>Æ </run>
            <run fontcolor='#59a14f' fontname='Tableau Regular' fontsize='8'>strongest</run>
            <run fontname='Tableau Regular' fontsize='8'>Æ </run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>wholesale sales months, averaging about </run>
            <run fontcolor='#59a14f' fontname='Tableau Regular' fontsize='8'>$34–36M</run>
            <run fontname='Tableau Regular' fontsize='8'>. </run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>This likely reflects retailer stock increases before major holiday periods. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>January</run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'> is consistently the </run>
            <run fontcolor='#e15759' fontname='Tableau Regular' fontsize='8'>weakest</run>
            <run fontname='Tableau Regular' fontsize='8'>Æ </run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>month, averaging around </run>
            <run fontcolor='#e15759' fontname='Tableau Regular' fontsize='8'>$24M</run>
            <run fontname='Tableau Regular' fontsize='8'>Æ </run>
            <run fontcolor='#666666' fontname='Tableau Regular' fontsize='8'>in sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='01b_monthly_seasonality' name='federated.042zb7i03n5ics1g00kto0srjgbu' />
          </datasources>
          <datasource-dependencies datasource='federated.042zb7i03n5ics1g00kto0srjgbu'>
            <column-instance column='[sales_month]' derivation='None' name='[none:sales_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sales_month]' derivation='None' name='[none:sales_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sales_year]' derivation='None' name='[none:sales_year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sales_year]' derivation='None' name='[none:sales_year:qk]' pivot='key' type='quantitative' />
            <column caption='Sales Month' datatype='integer' name='[sales_month]' role='dimension' type='quantitative'>
              <aliases>
                <alias key='1' value='January' />
                <alias key='2' value='February' />
                <alias key='3' value='March' />
                <alias key='4' value='April' />
                <alias key='5' value='May' />
                <alias key='6' value='June' />
                <alias key='7' value='July' />
                <alias key='8' value='August' />
                <alias key='9' value='September' />
                <alias key='10' value='October' />
                <alias key='11' value='November' />
                <alias key='12' value='December' />
              </aliases>
            </column>
            <column caption='Sales Year' datatype='integer' name='[sales_year]' role='dimension' type='quantitative' />
            <column-instance column='[total_sales]' derivation='Sum' name='[sum:total_sales:qk]' pivot='key' type='quantitative' />
            <column caption='Total Sales' datatype='real' name='[total_sales]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_month:qk]' included-values='in-range'>
            <min>1</min>
            <max>12</max>
          </filter>
          <filter class='quantitative' column='[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_year:qk]' included-values='in-range-or-null'>
            <min>2012</min>
            <max>2025</max>
          </filter>
          <slices>
            <column>[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_year:qk]</column>
            <column>[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_month:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.042zb7i03n5ics1g00kto0srjgbu].[sum:total_sales:qk]' value='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width' field='[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_year:ok]' value='36' />
