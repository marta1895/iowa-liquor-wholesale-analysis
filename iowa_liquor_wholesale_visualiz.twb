            <format attr='font-weight' field='[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_month:ok]' value='bold' />
            <format attr='font-family' field='[federated.042zb7i03n5ics1g00kto0srjgbu].[none:sales_year:ok]' value='Tableau Regular' />
